# Normalize line endings for cross-platform compatibility
* text=auto

# Force LF on these file types
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.svg  text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf
*.env* text eol=lf

# Binary files — never mess with these
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
*.woff2 binary
